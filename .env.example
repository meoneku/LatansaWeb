# Salin file ini menjadi .env.local lalu isi nilainya.

# ================================================================
# TELEGRAM (wajib diisi agar pesan form kontak tersimpan & muncul
# sebagai notifikasi real-time di Telegram)
#
# Cara mendapatkan:
# 1. Bot token  -> chat dengan @BotFather -> /newbot -> salin token
# 2. Chat ID    -> chat dengan @userinfobot -> salin "Id"
#                  (atau kirim pesan ke bot Anda lalu buka:
#                   https://api.telegram.org/bot<TOKEN>/getUpdates)
# 3. PENTING: kirim minimal satu pesan ("/start") ke bot Anda dari
#    akun yang akan menerima notifikasi, supaya bot bisa mengirim.
# ================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ================================================================
# EMAIL SMTP (opsional - cadangan selain Telegram)
# Untuk akun Outlook pribadi, umumnya:
#   SMTP_HOST = smtp-mail.outlook.com
#   SMTP_PORT = 587
# Jika dikosongkan, pengiriman email dilewati.
# ================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=meone@outlook.co.id
SMTP_PASS=

# Alamat tujuan penerima pesan kontak (opsional, default meone@outlook.co.id)
CONTACT_TO=meone@outlook.co.id

# Alamat pengirim pada header From (opsional, default SMTP_USER)
CONTACT_FROM=

# ================================================================
# SUPABASE (opsional - simpan kontak & newsletter ke database PostgreSQL)
# Paket: @supabase/server (core primitives) — RLS AKTIF.
#
# Cara mendapatkan (Dashboard -> Project Settings -> API Keys):
# 1. Project URL        -> SUPABASE_URL
# 2. publishable key    -> SUPABASE_PUBLISHABLE_KEY (sb_publishable_...)
# 3. secret key         -> SUPABASE_SECRET_KEY (sb_secret_...)
#    RAHASIA! server only — bypass RLS; seluruh CRUD lewat client ini
# 4. JWKS endpoint      -> SUPABASE_JWKS_URL (untuk verifikasi JWT
#    bila kelak memakai auth: 'user')
#    https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
#
# Jalankan SQL schema dari supabase-schema.sql di SQL Editor Supabase.
# Jika SUPABASE dikosongkan, fitur database dilewati (form tetap jalan
# via Telegram/SMTP seperti sebelumnya).
# ================================================================
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# ================================================================
# ADMIN PANEL /webmin (wajib untuk login panel)
# WEBMIN_SESSION_SECRET = kunci HMAC session cookie, min 32 karakter acak.
#   Generate:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Tanpa variabel ini, /webmin menolak login (503).
# ================================================================
WEBMIN_SESSION_SECRET=
